//- for extends only | block 覆蓋, append 新增在後, prepend 新增在前
extends _base.pug
block siteTitle
	title Graphic List | Orange Web Template v4.0 - orangeCat's photography
block siteCSS
	link(href="css/exsample.min.css" type="text/css" rel="stylesheet")
block container
	include _tools/_list.pug
	h2.page_title graphic list
	section.guide
		//浮動快速選單
		dl.jump
			dd: a(href="#graphic_list1") 上圖下文+濾鏡效果
			dd: a(href="#graphic_list2") 左圖右文
			dd: a(href="#graphic_pic1") 圖文重疊+轉場效果
	main.list
		h3.unit_title#graphic_list1 上圖下文 | + 濾鏡效果
		section.guide
			.note
				p #[span(style="color: #f00") * aspect-ratio] IE, Edge 87, Firefox 88, Opera 73, Chrome 87, iOS 15, Android Browser 4.4.4, Opera Mobile 12.1 以前不支援
				p 請參照 #[a(href="https://caniuse.com/?search=aspect-ratio" target="_blank") https://caniuse.com/?search=aspect-ratio]
			.guide
				h3 In SASS
				.codeArea
					include _extools/_guide.pug
					code.sass
						.EXcode
							+number
							p.comment // in _mixin.sass
						.EXcode
							+number
							p.tag #[i element].#[i customize class]
						.EXcode
							+number
							p.tag.cs1 +img_list01
						.EXcode
							+number
							p.tag.cs1 #[i element].content
						.EXcode
							+number
							p.comment.cs2 // in _effects.sass
						.EXcode
							+number
							p.tag.cs2 +imgfilter(#[i 100, grayscale])
				h3 In HTML
				.codeArea
					include _extools/_guide.pug
					code.html
						.EXcode
							+number
							p.tag
								span #[i element] class="#[i customize class]"
						.EXcode
							+number
							p.tag.cs1
								span #[i element] class="content"
						.EXcode
							+number
							p.tag.cs2
								span a
						.EXcode
							+number
							p.tag.cs3
								span figure
						.EXcode
							+number
							p.tag.cs4 #[span div class="img"]#[span img src="#[i upload/images.jpg]" alt="#[i image alt]"]#[span /div]
						.EXcode
							+number
							p.tag.cs4
								span figcaption
						.EXcode
							+number
							p.tag.cs5 #[span h3]#[i list title , 列表標題]#[span /h3]
						.EXcode
							+number
							p.tag.cs5 #[span p]#[i content text , 內容描述]#[span /p]
						.EXcode
							+number
							p.tag.cs4
								span /figcaption
						.EXcode
							+number
							p.tag.cs3
								span /figure
						.EXcode
							+number
							p.tag.cs2
								span /a
						.EXcode
							+number
							p.tag.cs1
								span #[i /element]
						.EXcode
							+number
							p.tag
								span #[i /element]
				h3 In PUG
				.codeArea
					include _extools/_guide.pug
					code.pug
						.EXcode
							+number
							p.tag #[i element].#[i customize class]
						.EXcode
							+number
							p.tag.cs1 #[i element].content
						.EXcode
							+number
							p.tag.cs2 a
						.EXcode
							+number
							p.tag.cs3 figure
						.EXcode
							+number
							p.tag.cs4 .img
						.EXcode
							+number
							p.tag.cs5 img(src="#[i upload/images.jpg]", alt="#[i alt]")
						.EXcode
							+number
							p.tag.cs4 figcaption
						.EXcode
							+number
							p.tag.cs5 h3 #[i list title , 列表標題]
						.EXcode
							+number
							p.tag.cs5 p #[i content text , 內容描述]
				h3 In PUG ( 模組化 )
				.codeArea
					include _extools/_guide.pug
					code.pug
						.EXcode
							+number
							p.tag #[i element]
						.EXcode
							+number
							p.tag.cs1 #[i element].content
						.EXcode
							+number
							p.tag.cs2 +img_list01('#[i #]', '#[i atitle]', '#[i upload/image.jpg]', '#[i alt]', '#[i list title , 列表標題]', '#[i content text , 內容描述]')
						.EXcode
							+number
							p.tag.cs2 1.連結, 2.連結標題, 3.圖檔位置, 4.圖說 5.文章標題, 6.內容描述, 很重要 順序不能錯誤 會找不到東西
