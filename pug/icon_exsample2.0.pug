block siteCSS
	link(href="css/exsample.min.css" type="text/css" rel="stylesheet")
block container
	h2.page_title google font icons v1.0
	section.guide
		//浮動快速選單
		dl.jump
			dd: a(href="#base") 基本常用
			dd: a(href="#base") 聯絡 & 表單
			dd: a(href="#contact") 會員
			dd: a(href="#cart") 購物車
			dd: a(href="#video") 影音
			dd: a(href="#orther") 其他 other
		.note
			p 利用 #[a(href="https://fonts.google.com/icons?selected=Material+Icons" title="Material Icons" target="_blank") GOOGLE Fonts] 做出來的工具包。紅字部分自行更換
		.guide
			h3 Include GOOGLE Font icon to SASS
			.code
				code
					p(style="word-break: break-all") @import url('https://fonts.googleapis.com/css?family=Material+Icons|Material+Icons+Outlined|Material+Icons+Two+Tone|Material+Icons+Round|Material+Icons+Sharp')
			h3 In SASS
			.code.code-row
				code
					p #[i // Material Icons Filled (base)]
					p #[span element].#[span icon class]
					p.element +google_icons(#[span icon name])
				code
					p #[i // Material Icons Round]
					p #[span element].#[span icon class]
					p.element +google_icons(#[span icon name], #[span round])
				code
					p #[i // Material Icons outlined]
					p #[span element].#[span icon class]
					p.element +google_icons(#[span icon name], #[span outlined])
				code
					p #[i // Material Icons Sharp]
					p #[span element].#[span icon class]
					p.element +google_icons(#[span icon name], #[span Sharp])
				code
					p #[i // Material Icons Two Tone]
					p #[span element].#[span icon class]
					p.element +google_icons(#[span icon name], #[span Two Tone])
			h3 In HTML
			.code
				code
					p &lt; #[span element] class="#[span icon class]"&gt;
					p.element &lt;span&gt;&lt;/span&gt;
					p.element #[span element].#[span icon class]
					p &lt;/#[span element]&gt;
