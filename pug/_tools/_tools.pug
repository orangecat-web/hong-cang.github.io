//- 用了 mixin 就不可用 block 變更
//- include 必須在 extends or block 之後
//- 使用方式 ex +fn('amit') 括符內要加 ''

//- breadcrumbs
//- exsample
//- include _tools.pug
//- ul#Breadcumbs
//- 	+breadcrumbs('首頁','index.html')
mixin breadcrumbs(label, href = "#")
	li
		a(href=href)
			= label

//- pagination
//- exsample
//- div
//- 	+pagination
mixin pagination
	- var n = 2;
	#Pagination
		ul.pagination
			li.first
				a.first(href="" title="第一頁")
					p
			li.prev
				a.prev(href="" title="上一頁")
					p
			li
					a(href="#" active)
						p 1
			while n < 11
				li
					a(href="#")
						p= n++
			li.next
				a.next(href="" title="下一頁")
					p
			li.last
				a.last(href="" title="最後頁")
					p
		.setting 共2頁/28筆
				span.dev-script-oper ,&nbsp;每頁顯示
				select(title="每頁顯示筆數")
					option(selected="selected") 12
					option 24
					option 26
				| 筆, 移至第&nbsp; #[input(type="text" title="移至第幾頁")]&nbsp;頁
				input(type="button" value="確定")