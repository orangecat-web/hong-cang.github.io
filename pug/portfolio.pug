		|
		|
		// image 濾鏡效果
		h3.unit_title#imgeffects Portfolio | Image Effects
		section.guide
			.note
				p 圖片濾鏡效果，可以直接使用在 &lt;img&gt; 上。
			.guide
				h3 In SASS
				.code
					code
						p #[i // _effects.sass line 80]
						p #[span element].#[span customize class]
						p.element +imgfilter #[span (count, imgfilter)]
						p #[i hue rotate 色相]、#[i blur 模糊]、#[i saturate 飽和] 運算方式不同，獨立寫三支。
						p #[i // 色相 _effects.sass line 119] #[span +hue-rotate($count)]
						p #[i // 模糊 _effects.sass line 124] #[span +blur($count)]
						p #[i // 飽和 _effects.sass line 129] #[span +saturate($count)]
				h3 In HTML
				.code
					code
						p &lt; #[span element] class="#[span customize class]"&gt;
						p.element &lt;img src="#[span upload/images.jpg]" alt="#[span image alt]&gt;
						p &lt;/#[span element]&gt;
		section.portfolio
			.content
				a(href="")
					figure
						.img
							img(src="upload/IMG_8157.JPG", alt="")
						figcaption
							h3 無濾鏡效果
							p SASS code | #[span +imgfilter]
