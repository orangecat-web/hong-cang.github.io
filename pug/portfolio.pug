//- for extends only | block 覆蓋, append 新增在後, prepend 新增在前
extends _base.pug
block siteTitle
	title Portfolio Effects | Orange Web Template v4.0 - orangeCat's photography
block siteCSS
	link(href="css/exsample.css" type="text/css" rel="stylesheet")
block container
	h2.page_title portfolio effects
	section.guide
		//浮動快速選單
		dl.jump
			dd: a(href="#pseffects") PS 濾鏡效果
			dd: a(href="#imgeffects") Image Effects
		.note
			p #[span(style="color: #f00") * aspect-ratio] IE, Edge 87, Firefox 88, Opera 73, Chrome 87, iOS 15, Android Browser 4.4.4, Opera Mobile 12.1 以前不支援
			p 請參照 #[a(href="https://caniuse.com/?search=aspect-ratio" target="_blank") https://caniuse.com/?search=aspect-ratio]
		.guide
			h3 In SASS
			.code
				code
					p #[i // _mixin.sass line 384]
					p #[span element].#[span customize class]
					p.element +gallery
					p 修改圖片比例
					p #[i // _mixin.sass line 410]
					p aspect-ratio:  #[span 1/1]
	main.portfolio
		// Photoshop 濾鏡效果
		h3.unit_title#pseffects Portfolio | PS 濾鏡效果
		section.guide
			.note
				p Photoshop 濾鏡效果，無法直接使用在 &lt;img&gt;，需要疊一層色塊在圖片上。工具寫在偽元素 ::before 裡。
				p 感覺實用性不高，不過都寫了還是留著備用。
			.guide
				h3 In SASS
				.code
					code
						p #[i // _effects.sass line 4]
						p #[i // color _colors.sass line 47]
						p #[span element].#[span customize class]
						p.element +pseffects #[span (effects name)]
				h3 In HTML
				.code
					code
						p &lt; #[span element] class="#[span customize class]"&gt;
						p.element &lt;img src="#[span upload/images.jpg]" alt="#[span image alt]&gt;
						p &lt;/#[span element]&gt;
		section.portfolio
			.content.pseffects00
				a(href="#")
					figure
						.img
							img(src="upload/IMG_8167.JPG", alt="")
						figcaption
							h3 無濾鏡效果
							p #[span SASS code |] +pseffects
			.content.pseffects01
				a(href="#")
					figure
						.img
							img(src="upload/IMG_8236.JPG", alt="")
						figcaption
							h3 multiply 色彩增值
							p #[span SASS code |] +pseffects(multiply)
			.content.pseffects02
