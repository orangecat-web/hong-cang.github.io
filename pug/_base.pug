doctype
//orangeCat template v4.0
html(lang="zh-Hant")
	head
		meta(charset="UTF-8")
		meta(http-equiv="x-ua-compatible" content="IE=edge, chrome=1")
		meta(http-equiv="content-language" content="zh-Hant-TW")
		meta(name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0")
		// for iOS
		//- meta(name="apple-mobile-web-app-capable" content="yes")
		meta(name="apple-mobile-web-app-status-bar-style" content="black")
		meta(name="format-detection" content="telephone=no")
		meta(name="format-detection" content="address=no")
		meta(name="author" content="orangeCat's photography")
		meta(name="copyright" content="orangeCat's photography")
		meta(name="description" content="orangeCat's photography 的網站基本模板設定")
		meta(name="keyword" content="網頁版型, 網站模板, orangeCat's photography, 基本樣式, website template, template")
		meta(property="og:title" content="orangeCat's photography web template")
		meta(property="og:url" content=" http://demo.orangecat.com.tw/oc-template/")
		meta(property="og:image" content=" http://demo.orangecat.com.tw/oc-template/images/logo.svg")
		// meta(property="fb:admins" content="Facebook numberic ID")
		meta(name="robots" content="noindex,nofollow")
		link(rel="icon" href="favicon.ico?v=1.1")
		block siteTitle
			title Orange Web Template v4.0 - orangeCat's photography
		block siteCSS
			link(href="css/pages.css" type="text/css" rel="stylesheet")
	body

		//- header
		header
			.navbar
				//- logo
				.logo
					h1
						a(href="." title="orangeCat's photography")
							img(src="images/logo.svg", alt="orangeCat's photography")
				// nav desktop
				nav.desktop
					ul.nav
						li
							a(href="basic_exsample.html" title="Basic Exsample") Basic Exsample
						li
							a(href="portfolio.html" title="Portfolio Effects") Portfolio Effects
						li
							a(href="graphic_list.html" title="Graphic List") Graphic List
						li
							a(href="icon_exsample.html" title="Google Icons") Google Icons
						li
							a(href="#" title="nav") nav5
				// nav mobile
				nav.mobile
					.navOpen
						button.js-open-left-slidebar.navOpen
							img(src="images/btn_open.svg", alt="open nav")
					div(off-canvas="slidebar-1 left overlay")
						button.js-close-left-slidebar.navClose
							img(src="images/btn_close.svg", alt="close nav")
						ul.nav
							li
								a(href="basic_exsample.html" title="Basic Exsample") Basic Exsample
							li
								a(href="portfolio.html" title="Portfolio Effects") Portfolio Effects
							li
								a(href="graphic_list.html" title="Graphic List") Graphic List
							li
								a(href="icon_exsample.html" title="Google Icons") Google Icons
							li
								a(href="#" title="nav") nav5
			block header
		main
			//- include _tools.pug
			block container
		footer
			//- copyright
			.copyright &copy;
				script.
						document.write(new Date().getFullYear())
				|  orangeCat's photography
		.goTop.hide
			a.goTop.jq-goTop(href="#")
				img(src="images/btn_gotop.svg", alt="")
		// basic script
		script(src="js/jquery-3.5.0.js")
		script(src="js/nav/slidebars.js")
		script(src="js/nav/slidebars-scripts.js")
		script(src="js/basic.js")
		block js